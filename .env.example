# ==============================================================================
# College Bus Tracker PWA - Environment Configuration
# ==============================================================================

# Allowed College Domain for Google Sign-In
ALLOWED_EMAIL_DOMAIN=aits.edu

# App Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Client Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-fcm-web-push-vapid-key

# Firebase Admin SDK (Server / Cloud Functions ONLY)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
# Note: Escape newlines in private key when in single line: "-----BEGIN PRIVATE KEY-----\nMIIE...-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# OSRM Routing Public / Hosted Endpoint
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org

# Local Firebase Emulator Flags
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

# Optional Sentry Monitoring
SENTRY_DSN=


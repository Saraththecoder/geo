{
  "rules": {
    "live": {
      "$busId": {
        ".read": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'driver' && auth.token.busId === $busId) || (auth.token.role === 'student' && auth.token.allocatedBusId === $busId))",
        ".write": "auth != null && (auth.token.role === 'admin' || (auth.token.role === 'driver' && auth.token.busId === $busId && newData.child('driverUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['lat', 'lng', 'speed', 'heading', 'accuracy', 'ts', 'tripId', 'driverUid', 'status']) && (!data.exists() || (newData.child('ts').val() - data.child('ts').val() >= 4000) || newData.child('status').val() === 'ended')",
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "speed": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "heading": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
        },
        "accuracy": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "tripId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "driverUid": {
          ".validate": "newData.isString() && (auth.token.role === 'admin' || newData.val() === auth.uid)"
        },
        "status": {
          ".validate": "newData.val() === 'active' || newData.val() === 'ended'"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
